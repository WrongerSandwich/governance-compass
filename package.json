    "@types/topojson-server": "^3.0.4",
    "@vitejs/plugin-react": "^6.1.1",
    "csv-parse": "^7.0.2",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "topojson-server": "^3.0.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
