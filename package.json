{
  "name": "governance-compass",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run build:geo && npm run build:study",
    "build": "next build",
    "build:geo": "tsx scripts/build-geo.ts",
    "build:study": "tsx scripts/build-synthetic-study.ts",
