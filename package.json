    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "d3-geo": "^3.1.1",
    "d3-geo-projection": "^4.0.0",
    "lucide-react": "^1.40.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "react-simple-maps": "^5.0.0",
